{
  "name": "revcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Pi-powered coding assistant for Autodesk Revit",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:web",
    "build:host": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:native": "dotnet test dotnet/Revcode.Tests/Revcode.Tests.csproj -c Release",
    "test:transport": "dotnet run --project dotnet/Revcode.TransportSmoke/Revcode.TransportSmoke.csproj -c Release",
    "test:browser": "node web/tests/browser-smoke.mjs",
    "test:highlighting": "node web/tests/highlighting-smoke.mjs",
    "test:skills-runs": "node web/tests/skills-runs-smoke.mjs",
    "test:provider-ui": "node web/tests/provider-sdk-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "vite --config web/vite.config.ts",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "build:install": "node scripts/build-install.mjs",
    "install:revit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7",
    "zeromq": "6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  }
}
