<Project>
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)' == ''">2026</RevitYear>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(RevitYear)' != '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(RevitYear)' == '2027'">net10.0-windows</TargetFramework>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitInstallDir>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BaseIntermediateOutputPath>obj/$(RevitYear)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(RevitYear)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
